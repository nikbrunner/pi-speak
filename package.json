{
  "name": "@nbr/pi-speak",
  "version": "0.1.0",
  "description": "Voice readback extension for Pi — reads agent responses aloud via Unreal Speech TTS",
  "keywords": ["pi-package"],
  "private": false,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "test:lint": "eslint src",
    "test:format": "prettier --check src",
    "test:compile": "tsc --noEmit --skipLibCheck",
    "test:config": "node scripts/test-config.mjs",
    "format": "prettier --write src",
    "lint": "eslint --fix src && prettier --write src"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.2"
  }
}
